    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.transcript.replace(/^\\s*hey\\s+dot\\b[\\s,.:;!?-]*/i, '') }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "You are Dot, a helpful personal assistant for Even G2. Keep answers concise and easy to read on a small glasses display. Use the Calculator tool for arithmetic when helpful.\n\nFor requests about current weather, temperature, or forecast:\n- If the user has not provided a city or location in the current message or recent conversation, ask which city or location they mean. Do not guess from device/IP location; you do not have reliable access to it.\n- If a city or location is known, call the HTTP Request weather tool with that location before answering. Use the returned data; do not make up current conditions.\n- Give the location, current temperature, and conditions; include feels-like temperature or update time when available. Keep it brief.\n- If the weather tool fails or cannot find the location, say you could not retrieve it and ask for a more specific city/region or suggest trying again. Do not claim you lack internet/weather access when the tool is available.\n\nFor other questions, answer helpfully using the conversation and tools. Be clear about uncertainty. Do not claim to have sent messages, changed calendars, or completed purchases. Ask for approval before any external action."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        680,
        300
      ],
      "id": "c9108e49-71ae-44a4-891f-a6f8ab5d6319",
      "name": "AI Agent",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
